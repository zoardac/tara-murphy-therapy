---
const services = [
  {
    icon: '🌙',
    title: 'Individual Therapy',
    description: "One-on-one sessions tailored to your unique journey. We'll explore your inner landscape with curiosity and care, working through anxiety, depression, trauma, and life transitions."
  },
  {
    icon: '🌊',
    title: 'Nature-Based Sessions',
    description: 'Outdoor therapy experiences that integrate walking, mindfulness, and connection with the natural world. Harness the healing power of forests, coastlines, and open skies.'
  },
  {
    icon: '✨',
    title: 'Ritual & Ceremony',
    description: 'Therapeutic rituals to mark transitions, honor grief, or celebrate growth. Incorporate meaningful practices that align with your values and spiritual path.'
  }
];
---

<section id="services" class="relative py-24 px-[5%] max-w-[1400px] mx-auto">
  <h2 class="section-title font-serif text-5xl font-normal text-blue-black text-center mb-16 relative">
    Services
    <span class="block mt-4 text-blush text-xl opacity-60">✦</span>
  </h2>
  
  <div class="grid md:grid-cols-3 gap-12 mt-12">
    {services.map((service) => (
      <div class="service-card p-12 bg-white rounded-sm border border-olive/10 transition-all duration-400 relative overflow-hidden hover:-translate-y-1 hover:shadow-xl hover:border-olive/20">
        <span class="text-5xl mb-6 block">{service.icon}</span>
        <h3 class="font-serif text-3xl text-blue-black mb-4 font-semibold">{service.title}</h3>
        <p class="text-gray-blue leading-relaxed">{service.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: linear-gradient(to bottom, theme('colors.blush'), theme('colors.olive'));
    transition: height 0.4s ease;
  }

  .service-card:hover::before {
    height: 100%;
  }

  section::before {
    content: '';
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    opacity: 0.03;
    pointer-events: none;
    z-index: 0;
    bottom: -100px;
    left: -150px;
    background: radial-gradient(circle, theme('colors.blush') 0%, transparent 70%);
  }
</style>
