---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Tara Murphy Therapy - Compassionate counseling rooted in connection and authenticity" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Quattrocento:wght@400;700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="font-body bg-cream text-blue-black overflow-x-hidden">
    <slot />
  </body>
</html>

<style is:global>
  /* Layered texture overlay */
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.4;
    pointer-events: none;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(212, 165, 165, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(107, 124, 93, 0.06) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(122, 139, 158, 0.04) 0%, transparent 60%);
    z-index: 0;
  }

  body::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.015;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg width='200' height='200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' /%3E%3C/filter%3E%3Crect width='200' height='200' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
    z-index: 0;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-20px, -30px) scale(1.05); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes sway {
    0%, 100% { transform: rotate(-5deg) translateY(0); }
    50% { transform: rotate(5deg) translateY(-20px); }
  }

  @keyframes fogRoll {
    0% { 
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.5;
    }
    25% { 
      transform: translate(-3%, 2%) rotate(1deg);
      opacity: 0.7;
    }
    50% { 
      transform: translate(-5%, -2%) rotate(0deg);
      opacity: 0.6;
    }
    75% { 
      transform: translate(-2%, 3%) rotate(-1deg);
      opacity: 0.7;
    }
    100% { 
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.5;
    }
  }

  @keyframes gentleShift {
    0%, 100% { opacity: 0.6; transform: scale(1) translate(0, 0); }
    50% { opacity: 0.8; transform: scale(1.05) translate(-10px, -10px); }
  }
</style>
