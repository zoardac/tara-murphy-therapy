---
const approaches = [
  {
    title: 'Rooted in Evidence',
    description: 'Integrating cognitive-behavioral therapy, somatic practices, and mindfulness-based interventions with nature-connected wisdom.'
  },
  {
    title: 'Trauma-Informed',
    description: 'Creating safety and trust while honoring your pace, your story, and your resilience.'
  },
  {
    title: 'Culturally Responsive',
    description: 'Celebrating diverse identities and experiences while acknowledging the healing traditions of indigenous peoples.'
  },
  {
    title: 'Holistic Healing',
    description: 'Addressing mind, body, spirit, and environment as interconnected parts of your whole self.'
  }
];
---

<section id="approach" class="approach-section relative py-24 px-[5%] overflow-hidden">
  <div class="leaf-decoration absolute opacity-[0.04] pointer-events-none bottom-[15%] right-[8%] text-6xl animate-sway-reverse">🍃</div>
  <div class="leaf-decoration absolute opacity-[0.03] pointer-events-none bottom-[40%] left-[8%] text-5xl animate-sway">🌿</div>
  
  <div class="max-w-[800px] mx-auto text-center relative z-10">
    <h2 class="section-title font-serif text-5xl font-normal text-blue-black text-center mb-16 relative">
      My Approach
      <span class="block mt-4 text-blush text-xl opacity-60">✦</span>
    </h2>
    
    <ul class="list-none mt-12">
      {approaches.map((approach, index) => (
        <li 
          class="approach-item p-8 mb-6 bg-white rounded-sm border-l-[3px] border-olive text-left transition-all duration-300 hover:border-blush hover:shadow-lg opacity-0"
          style={`animation: slideIn 0.6s ease-out forwards; animation-delay: ${(index + 1) * 0.1}s;`}
        >
          <strong class="font-serif text-2xl text-olive block mb-2">{approach.title}</strong>
          {approach.description}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .approach-section {
    background: 
      radial-gradient(circle at 30% 20%, rgba(107, 124, 93, 0.04) 0%, transparent 50%),
      radial-gradient(circle at 70% 80%, rgba(212, 165, 165, 0.06) 0%, transparent 50%),
      linear-gradient(to bottom, theme('colors.fog') 0%, theme('colors.cream') 100%);
  }

  .approach-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      repeating-linear-gradient(45deg, transparent, transparent 35px, rgba(107, 124, 93, 0.01) 35px, rgba(107, 124, 93, 0.01) 70px);
    pointer-events: none;
  }

  .animate-sway-reverse {
    animation: sway 10s ease-in-out infinite reverse;
  }
</style>
