---

<section id="contact" class="py-24 px-[5%] bg-blue-black text-cream text-center">
  <h2 class="section-title font-serif text-5xl font-normal text-cream text-center mb-16 relative">
    Get in Touch
    <span class="block mt-4 text-blush text-xl opacity-60">✦</span>
  </h2>
  
  <div class="grid md:grid-cols-3 gap-12 max-w-[900px] mx-auto my-12">
    <div class="contact-item p-8 bg-white/[0.03] border border-white/10 rounded-sm transition-all duration-300 hover:bg-white/[0.05] hover:border-blush/30">
      <h3 class="font-serif text-2xl text-blush mb-4 font-normal">Email</h3>
      <p class="text-gray-blue leading-relaxed">
        <a href="mailto:hello@taramurphytherapy.com" class="text-cream no-underline border-b border-transparent transition-all duration-300 hover:border-blush">
          hello@taramurphytherapy.com
        </a>
      </p>
    </div>
    
    <div class="contact-item p-8 bg-white/[0.03] border border-white/10 rounded-sm transition-all duration-300 hover:bg-white/[0.05] hover:border-blush/30">
      <h3 class="font-serif text-2xl text-blush mb-4 font-normal">Phone</h3>
      <p class="text-gray-blue leading-relaxed">
        <a href="tel:555-123-4567" class="text-cream no-underline border-b border-transparent transition-all duration-300 hover:border-blush">
          (555) 123-4567
        </a>
      </p>
    </div>
    
    <div class="contact-item p-8 bg-white/[0.03] border border-white/10 rounded-sm transition-all duration-300 hover:bg-white/[0.05] hover:border-blush/30">
      <h3 class="font-serif text-2xl text-blush mb-4 font-normal">Location</h3>
      <p class="text-gray-blue leading-relaxed">
        Pacific Northwest<br />
        In-person & Virtual Sessions
      </p>
    </div>
  </div>
  
  <p class="mt-12 text-gray-blue">Currently accepting new clients</p>
</section>
